{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/opensiro/vsm-oss-organization/schemas/external-tool-entry.schema.json",
  "title": "OpenSiro external tool entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id",
    "provider",
    "integration",
    "external_boundary",
    "connection_owner",
    "runtime_users",
    "technical_permissions",
    "action_policy",
    "revocation",
    "failure_behavior",
    "reentry_triggers",
    "evidence_retention"
  ],
  "properties": {
    "entry_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "integration": {"type": "string", "minLength": 1},
    "external_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "resources"],
      "properties": {
        "service": {"type": "string", "minLength": 1},
        "resources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "connection_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "authority_ref"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "authority_ref": {"type": "string", "minLength": 1}
      }
    },
    "runtime_users": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "technical_permissions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "action_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegated", "parent_gated", "forbidden"],
      "properties": {
        "delegated": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "parent_gated": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "forbidden": {"type": "array", "items": {"$ref": "#/$defs/action"}}
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "path"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "failure_behavior": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reentry_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_retention": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "actions", "rationale"],
      "properties": {
        "class": {
          "type": "string",
          "enum": ["READ_ONLY", "BOUNDED_MUTATION", "INTEGRATION_SENSITIVE", "POLICY_SECURITY_SENSITIVE", "FORBIDDEN"]
        },
        "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
